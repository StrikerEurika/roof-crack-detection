# Exceptions: Allow images in assets/ or docs/ if they are documentation/UI assets
!/assets/**/*.png
!/assets/**/*.jpg
!/assets/**/*.jpeg
!/docs/**/*.png
!/docs/**/*.jpg
!/docs/**/*.jpeg

